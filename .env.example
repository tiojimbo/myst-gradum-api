# Aplicacao
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://gradum:replace-local-password@postgres:5432/gradum
DIRECT_URL=postgresql://gradum:replace-local-password@postgres:5432/gradum
JWT_ACCESS_SECRET=
BCRYPT_ROUNDS=12

# Servicos locais
POSTGRES_USER=gradum
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=gradum
POSTGRES_CONTAINER=myst-gradum-postgres
REDIS_URL=redis://redis:6379
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-local-password
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Backup
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7

# Producao
API_IMAGE=ghcr.io/example/myst-gradum-api:sha
WEB_IMAGE=ghcr.io/example/myst-gradum-web:sha
API_DOMAIN=api.example.invalid
WEB_DOMAIN=app.example.invalid
CERTBOT_EMAIL=admin@example.invalid
MINIO_ROOT_USER=replace-minio-user
MINIO_ROOT_PASSWORD=replace-minio-password
MINIO_BUCKET=gradum-uploads
